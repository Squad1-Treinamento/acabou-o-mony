server.port=8081

spring.application.name=3ds-engine

spring.redis.host=localhost
spring.redis.port=6379
spring.redis.password=${SPRING_REDIS_PASSWORD:}
spring.redis.timeout=2000ms

management.endpoints.web.exposure.include=health

jwt.secret=${JWT_SECRET:dev-secret-key-that-is-at-least-256-bits-long-for-hs256!!}
jwt.expiration-seconds=600

3ds.api-key=${3DS_API_KEY:dev-api-key-change-in-production}
3ds.rate-limit-enabled=true
3ds.session-ttl-seconds=600
3ds.auth-result-ttl-seconds=86400
3ds.redirect-base-url=${3DS_REDIRECT_BASE_URL:http://localhost:8081/challenge}
3ds.callback-url=${3DS_CALLBACK_URL:http://localhost:8080/api/v1/payments/3ds-callback}
3ds.rate-limit-per-second=100

risk.score-threshold=70
risk.high-value-threshold=5000.00
