# ============================================================================
# Acabou o Mony - Environment Variables Configuration
# ============================================================================
# Copy this file to .env and configure with your values
# DO NOT commit .env to version control (add to .gitignore)
# ============================================================================

# ----------------------------------------------------------------------------
# Nginx Reverse Proxy Configuration
# ----------------------------------------------------------------------------
UPSTREAMS=core-payment:8080
UPSTREAM_HOST=
UPSTREAM_PORT=
ENVIRONMENT=development

# ----------------------------------------------------------------------------
# Ngrok Configuration (for local development)
# ----------------------------------------------------------------------------
NGROK_AUTHTOKEN=

# ----------------------------------------------------------------------------
# Redis Connection Configuration
# ----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT_MS=5000

# ----------------------------------------------------------------------------
# Redis Connection Pool (Lettuce)
# ----------------------------------------------------------------------------
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0

# ----------------------------------------------------------------------------
# Cache TTL Configuration (seconds)
# ----------------------------------------------------------------------------
# Merchant Configuration: Semi-static data (name, address, business config)
CACHE_TTL_MERCHANT_CONFIG=86400

# Risk Thresholds: Fraud rules, value limits, score thresholds
CACHE_TTL_RISK_THRESHOLDS=7200

# BIN Lookup Results: Bank issuer, ACS URL, country, card type
CACHE_TTL_BIN_LOOKUP=604800

# Transaction History Metadata: Transaction IDs, timestamps, status (no card data)
CACHE_TTL_TRANSACTION_HISTORY=60

# Idempotency Keys: Complete transaction result for duplicate prevention
CACHE_TTL_IDEMPOTENCY_KEY=86400

# ----------------------------------------------------------------------------
# Cache Behavior Configuration
# ----------------------------------------------------------------------------
# Enable/disable cache globally
CACHE_ENABLED=true

# Fallback to database if Redis is unavailable (circuit breaker)
CACHE_FALLBACK_TO_DB_ON_ERROR=true

# ----------------------------------------------------------------------------
# Cache Encryption Configuration (for future use with sensitive data)
# ----------------------------------------------------------------------------
# WARNING: Sensitive data should NOT be cached in MVP
# This infrastructure is prepared but not used by default
CACHE_ENCRYPT_SENSITIVE_DATA=false

# AES-256 encryption key (base64 encoded, 256 bits)
# Generate with: openssl rand -base64 32
# Required if CACHE_ENCRYPT_SENSITIVE_DATA=true
CACHE_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Circuit Breaker Configuration (Resilience4j)
# ----------------------------------------------------------------------------
# Enable/disable circuit breaker for Redis
CACHE_CIRCUIT_BREAKER_ENABLED=true

# Number of consecutive failures before opening circuit
CACHE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3

# Wait duration (seconds) before attempting to reconnect (HALF_OPEN state)
CACHE_CIRCUIT_BREAKER_WAIT_DURATION_SECONDS=30

# Sliding window size for calculating failure rate
CACHE_CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=10

# ----------------------------------------------------------------------------
# 3DS / MFA Auth Engine Configuration
# ----------------------------------------------------------------------------
# JWT Secret for signing 3DS challenge tokens
JWT_SECRET=mony-3ds-jwt-secret-for-challenge-tokens-2024-production

# Shared API key: core-payment sends it, 3ds-engine validates it
# THREEDS_API_KEY  → used by core-payment (ThreeDsClient) and docker-compose default
# THREEDS_ENGINE_API_KEY is mapped to 3ds.api-key inside the 3ds-engine container
THREEDS_API_KEY=mony-3ds-api-key-2024-secure
THREEDS_BASE_URL=http://3ds-engine:8080

# 3DS Challenge Session TTL (seconds)
THREEDS_CHALLENGE_TTL=600

# Core Service callback URL (for async notifications)
CORE_SERVICE_CALLBACK_URL=http://core-service:8080/api/v1/payments/3ds-callback

# ----------------------------------------------------------------------------
# Core Payment Service Configuration
# ----------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://database-payment:5432/payment-service
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root123

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_TIMEOUT=5000

# ----------------------------------------------------------------------------
# Mercado Pago API Configuration
# ----------------------------------------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=test-token
MERCADO_PAGO_API_URL=https://api.mercadopago.com

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
# Log level: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Structured logging format (json or text)
LOG_FORMAT=json

# ----------------------------------------------------------------------------
# Application Ports
# ----------------------------------------------------------------------------
# Nginx Reverse Proxy
NGINX_PORT=8080

# 3DS Engine
THREEDS_ENGINE_PORT=8081

# Core Service
CORE_SERVICE_PORT=8082

# ----------------------------------------------------------------------------
# Security Configuration (Production)
# ----------------------------------------------------------------------------
# Enable TLS for Redis connections (use rediss:// protocol)
# REDIS_TLS_ENABLED=false

# Redis password authentication (required in production)
# REDIS_PASSWORD=strong_password_here

# Enable Redis ACL (Access Control List)
# REDIS_ACL_ENABLED=false
# REDIS_ACL_USERNAME=default

# ----------------------------------------------------------------------------
# Development / Testing Configuration
# ----------------------------------------------------------------------------
# Enable debug mode (verbose logging, stack traces)
DEBUG_MODE=false

# Enable test mode (use in-memory Redis, mock external APIs)
TEST_MODE=false

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# 1. TTL Values:
#    - Short (60-300s): Highly volatile data (transaction history)
#    - Medium (7200s): Dynamic data (risk thresholds)
#    - Long (86400-604800s): Semi-static data (merchant config, BIN lookup)
#
# 2. Circuit Breaker:
#    - Protects application from cascading failures
#    - Automatically opens after FAILURE_THRESHOLD consecutive failures
#    - Automatically recovers after WAIT_DURATION_SECONDS
#
# 3. Encryption:
#    - Infrastructure prepared but not used in MVP
#    - Enable only if caching sensitive data (not recommended)
#    - Always use strong encryption keys (256 bits minimum)
#
# 4. Security:
#    - Never commit .env to version control
#    - Use strong passwords in production
#    - Enable TLS for Redis in production
#    - Rotate secrets regularly
#
# 5. Idempotency:
#    - Idempotency-Key format: UUID v4
#    - TTL 24h (industry standard)
#    - Prevents duplicate charges and retry storms
# ============================================================================
