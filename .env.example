# Exemplo de arquivo .env para configuração do ambiente
# Substitua os valores abaixo conforme necessário para o seu ambiente de desenvolvimento

NGROK_AUTHTOKEN=<sua-chave-de-autenticação-ngrok-aqui>
UPSTREAMS=app:8080

# Optional single-backend fallback
# UPSTREAM_HOST=app
# UPSTREAM_PORT=8080

# Ambiente: development, staging, production
# development = habilita debug headers (X-Upstream-Server)
# staging/production = desabilita debug headers
# ENVIRONMENT=development